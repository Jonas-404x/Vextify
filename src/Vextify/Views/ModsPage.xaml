<Page x:Class="Vextify.Views.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Mods">
    <Page.Resources>
        <!-- Each mod is its own rounded card; the hover highlight is the same rounded shape (no square layer over round corners). -->
        <DataTemplate x:Key="ModRowTemplate">
            <Border x:Name="Row" MinHeight="64" Margin="0,0,0,8" Padding="18,12" CornerRadius="10" Cursor="Hand"
                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Tag="{Binding}" MouseLeftButtonUp="Row_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource VxRowTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource VxBody}" FontSize="13" Margin="0,2,0,0"
                                   MaxHeight="36" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PerfLabel}" FontSize="12" Foreground="#FFB454" Margin="0,4,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PerfLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                     Tag="{Binding}" Click="Toggle_Click" AutomationProperties.Name="{Binding Name}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <!-- No ScrollViewer of our own: the navigation view's DynamicScrollViewer scrolls the page, a nested one would swallow the wheel. -->
    <StackPanel Margin="32,24,32,96" MaxWidth="820" HorizontalAlignment="Stretch">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mods" Style="{StaticResource VxTitle}" VerticalAlignment="Center" />
            <ui:TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Mods durchsuchen" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="Search_Changed" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Add24}" Content="Hinzufügen" Click="Add_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- empty state: say what to do next -->
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0">
            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource VxTitle}" FontSize="20" TextAlignment="Center" Margin="0,12,0,4" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource VxBody}" TextAlignment="Center" MaxWidth="420" />
            <ui:Button x:Name="EmptyButton" Appearance="Primary" Content="Zur Startseite" HorizontalAlignment="Center" Margin="0,16,0,0" Click="GoStart_Click" />
        </StackPanel>

        <TextBlock x:Name="ExtHeader" Text="Extensions" Style="{StaticResource VxHeadline}" Margin="4,8,0,8" />
        <ItemsControl x:Name="ExtList" ItemTemplate="{StaticResource ModRowTemplate}" />

        <TextBlock x:Name="AppHeader" Text="Custom Apps" Style="{StaticResource VxHeadline}" Margin="4,20,0,8" />
        <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource ModRowTemplate}" />

        <ui:Button Appearance="Secondary" Margin="0,12,0,0" HorizontalAlignment="Left" Icon="{ui:SymbolIcon Search24}"
                   Content="Mehr Mods in Entdecken finden" Click="GoDiscover_Click" />
    </StackPanel>
</Page>
