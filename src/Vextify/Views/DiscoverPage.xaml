<Page x:Class="Vextify.Views.DiscoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Entdecken">
    <StackPanel Margin="32,24,32,96" MaxWidth="900" HorizontalAlignment="Stretch">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Entdecken" Style="{StaticResource VxTitle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                <ui:Button x:Name="TabThemes" Content="Themes" Click="TabThemes_Click" Margin="0,0,6,0" />
                <ui:Button x:Name="TabExtensions" Content="Extensions" Click="TabExtensions_Click" />
            </StackPanel>
            <ui:TextBox Grid.Column="2" x:Name="SearchBox" PlaceholderText="Suchen" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="Search_Changed" VerticalAlignment="Center" />
        </Grid>

        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed">
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,12,0" />
            <TextBlock Text="Katalog wird geladen …" Style="{StaticResource VxBody}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed">
            <ui:SymbolIcon x:Name="MessageIcon" Symbol="Search24" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageTitle" Style="{StaticResource VxTitle}" FontSize="20" TextAlignment="Center" Margin="0,12,0,4" />
            <TextBlock x:Name="MessageText" Style="{StaticResource VxBody}" TextAlignment="Center" MaxWidth="420" />
            <ui:Button x:Name="RetryButton" Content="Erneut versuchen" HorizontalAlignment="Center" Margin="0,16,0,0" Click="Retry_Click" />
        </StackPanel>

        <WrapPanel x:Name="Cards" />

        <ui:Button x:Name="MoreButton" Content="Mehr laden" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" Click="More_Click" />
    </StackPanel>
</Page>
