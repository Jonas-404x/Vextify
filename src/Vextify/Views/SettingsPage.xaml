<Page x:Class="Vextify.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Einstellungen">
    <!-- hosted by the navigation view -->
        <StackPanel Margin="32,24,32,96" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Einstellungen" Style="{StaticResource VxTitle}" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <TextBlock Text="Mit Windows starten" FontWeight="SemiBold" />
                        <TextBlock Text="Vextify läuft dann unauffällig im Tray und hält deine Mods aktiv." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutostartSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Autostart_Click" />
                </Grid>
            </ui:Card>
            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <TextBlock Text="Mods nach Spotify-Updates automatisch erneuern" FontWeight="SemiBold" />
                        <TextBlock Text="Spotify überschreibt die Mods bei jedem Update. Vextify bemerkt das und wendet sie wieder an." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ReapplySwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Reapply_Click" />
                </Grid>
            </ui:Card>
            <ui:Card Margin="0,0,0,8" Padding="16,12">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <TextBlock Text="Spotify dafür automatisch neu starten" FontWeight="SemiBold" />
                        <TextBlock Text="Nötig, wenn Spotify gerade läuft. Wiedergabe stoppt dabei kurz." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="RestartSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Restart_Click" />
                </Grid>
            </ui:Card>
            <ui:Card Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <TextBlock Text="Beim Schließen im Tray weiterlaufen" FontWeight="SemiBold" />
                        <TextBlock Text="Das Fenster verschwindet, Vextify bleibt aktiv. Beenden geht über das Tray-Icon." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="TraySwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Tray_Click" />
                </Grid>
            </ui:Card>

            <TextBlock Text="Wartung" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}" Content="Original-Spotify wiederherstellen" Click="Restore_Click" Margin="0,0,8,0" />
                <ui:Button Icon="{ui:SymbolIcon Document24}" Content="Protokoll öffnen" Click="Log_Click" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Opacity="0.5" FontSize="12" Margin="0,24,0,0" />
        </StackPanel>
    <!-- /hosted -->
</Page>
